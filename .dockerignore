# Keep the build context minimal: the Dockerfile only COPYs scripts/render.sh
# and content/, so everything else is local tooling that must not reach the
# daemon. No git metadata, no working notes, no editor cruft.
.git
**/.gitignore
**/*.md~
*.swp
.DS_Store
# Local env overrides (compose reads these, the image build never does)
.env

# Generated scan artifacts (scripts/scan.sh)
sbom.cdx.json

Makefile
docs/
scripts/check-pins.sh
scripts/check-render.sh
scripts/neg-check-render.sh
scripts/test-check-pins.sh
scripts/test-nginx-conf.sh
scripts/scan.sh